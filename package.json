{
  "name": "heko",
  "productName": "Heko",
  "version": "4.0.0",
  "description": "",
  "main": "src/js/main/index.js",
  "scripts": {
    "build": "electron-builder",
    "start": "electron ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "homepage": "https://github.com/Hydrened/Heko#readme",
  "bugs": {
    "url": "https://github.com/Hydrened/Heko/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hydrened/Heko.git"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^25.9.8",
    "electron": "^40.10.5",
    "electron-builder": "^26.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "conf": "^15.1.0",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.heko.app",
    "productName": "Heko",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": {
        "target": "nsis"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Hydrened",
        "repo": "Heko"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
